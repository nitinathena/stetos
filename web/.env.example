# Copy this file to .env.local for local development (next dev reads it
# automatically). In Vercel, set these under Project Settings -> Environment
# Variables instead - never commit real values.

# Your Supabase project's base URL (no trailing path, e.g. NOT /rest/v1/)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key - full-privilege secret, server-side only. Used by the
# Python functions (api/predict.py, api/sync.py) to read Storage and write
# to the "predictions" table regardless of RLS policies. NEVER prefix this
# with NEXT_PUBLIC_ and never send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret checked by /api/sync so only your own Vercel Cron job (or you,
# manually, via the "Sync now" button) can trigger a sync - without this,
# anyone who finds the URL could trigger repeated Supabase Storage downloads
# and inference runs. Must be named exactly CRON_SECRET: Vercel automatically
# sends this value as an `Authorization: Bearer <value>` header on every
# cron-triggered request when an env var with this exact name is set - see
# https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs
CRON_SECRET=generate-a-random-string-at-least-16-chars
